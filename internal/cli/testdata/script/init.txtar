# init creates the vault layout, prints its root, and writes no index.
exec specshelf --home $WORK/vault init
cmppath stdout init.stdout
exists $WORK/vault/specs
exists $WORK/vault/decisions
exists $WORK/vault/templates/spec.md
exists $WORK/vault/templates/decision.md
exists $WORK/vault/README.md
! exists $WORK/vault/index.jsonl

# A user-edited template survives a second init, which still prints the root.
cp edited-template.md $WORK/vault/templates/spec.md
exec specshelf --home $WORK/vault init
cmppath stdout init.stdout
grep 'user edit survives' $WORK/vault/templates/spec.md

# A relative --home is resolved to an absolute root, as the reference does.
exec specshelf --home rel-vault init
cmppath stdout relinit.stdout
exists $WORK/rel-vault/specs

-- init.stdout --
$WORK/vault
-- relinit.stdout --
$WORK/rel-vault
-- edited-template.md --
# user edit survives
