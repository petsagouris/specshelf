# new takes the reference multi-value flags: repeated, comma-separated, trimmed
# and de-duplicated, in first-seen order.
exec specshelf --home $WORK/vault new 'Hello world' --repos a,b --repos b --repo c --tags x --tags ' y ' --codex-session s1 --codex-session s2,s1
stdout 'vault/specs/\d{4}-\d{2}-\d{2}-hello-world\.md$'

# The parsed flags land in the document and the index follows the write.
exec specshelf --home $WORK/vault list
stdout 'spec-\d{8}-hello-world\tspec\tactive\t\d{4}-\d{2}-\d{2}\ta,b,c\tx,y\ts1,s2\tspecs/\d{4}-\d{2}-\d{2}-hello-world\.md\tHello world'
exists $WORK/vault/index.jsonl

# The current-session flag reads CODEX_THREAD_ID and errors when it is unset.
env CODEX_THREAD_ID=
env CODEX_SESSION_ID=
! exec specshelf --home $WORK/vault new 'No session' --current-codex-session
stderr '^specshelf: CODEX_THREAD_ID is not set$'

env CODEX_THREAD_ID=thread-9
exec specshelf --home $WORK/vault new 'Current session' --current-codex-session
stdout 'vault/specs/\d{4}-\d{2}-\d{2}-current-session\.md$'
exec specshelf --home $WORK/vault list
stdout 'thread-9'

# With no thread id it falls back to CODEX_SESSION_ID.
env CODEX_THREAD_ID=
env CODEX_SESSION_ID=session-7
exec specshelf --home $WORK/vault new 'Fallback session' --current-codex-session
stdout 'vault/specs/\d{4}-\d{2}-\d{2}-fallback-session\.md$'
exec specshelf --home $WORK/vault list
stdout 'session-7'

# --slug uses the hand-picked slug verbatim for the file name and the id, in
# place of the one derived from the title.
exec specshelf --home $WORK/slug new 'Some Title' --slug my-picked-slug
stdout 'slug/specs/\d{4}-\d{2}-\d{2}-my-picked-slug\.md$'
exec specshelf --home $WORK/slug list
stdout 'spec-\d{8}-my-picked-slug\tspec\tactive'

# A second document with the same slug keeps a distinct id and file name.
exec specshelf --home $WORK/slug new 'Another Title' --slug my-picked-slug
stdout 'slug/specs/\d{4}-\d{2}-\d{2}-my-picked-slug-2\.md$'
exec specshelf --home $WORK/slug list
stdout 'spec-\d{8}-my-picked-slug-2\tspec\tactive'
