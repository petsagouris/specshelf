# search matches the metadata first and reports the title with no line suffix.
exec specshelf --home $WORK/vault search Alpha
cmp stdout metadata.stdout

# A body match reports its 1-based line number.
exec specshelf --home $WORK/vault search needle
cmp stdout body.stdout

# Filters narrow the search the same way they narrow list.
exec specshelf --home $WORK/vault search tooling --kind decision
cmp stdout filtered.stdout

