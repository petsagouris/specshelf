# status sets the frontmatter status and bumps updated to today, leaving created
# and the body alone; the index follows.
exec specshelf --home $WORK/vault status spec-20261017-note accepted
cmpenv stdout status.stdout
grep 'status: accepted' vault/specs/2026-10-17-note.md
grep 'created: 2000-01-01' vault/specs/2026-10-17-note.md
! grep 'updated: 2000-01-01' vault/specs/2026-10-17-note.md
grep 'updated: \d{4}-\d{2}-\d{2}' vault/specs/2026-10-17-note.md
grep '"status": "accepted"' vault/index.jsonl
grep '# Note' vault/specs/2026-10-17-note.md

# An unknown reference fails without touching anything.
! exec specshelf --home $WORK/vault status missing accepted
stderr '^specshelf: unknown reference "missing"$'

-- status.stdout --
$WORK/vault/specs/2026-10-17-note.md
-- vault/specs/2026-10-17-note.md --
---
id: spec-20261017-note
kind: spec
title: Note
status: active
created: 2000-01-01
updated: 2000-01-01
---
# Note
