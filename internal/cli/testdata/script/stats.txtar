# stats prints the vault's counts grouped by kind, status, repo and tag as
# three tab-separated columns — group, key, count — with a stable order.

exec specshelf --home $WORK/vault stats
cmp stdout stats.tsv

# An empty vault has nothing to count.
exec specshelf --home $WORK/empty stats
! stdout .

-- stats.tsv --
kind	decision	1
kind	spec	2
status	accepted	1
status	active	2
repo	billing	1
repo	infra	1
tag	tooling	2
-- vault/specs/2026-10-17-alpha.md --
