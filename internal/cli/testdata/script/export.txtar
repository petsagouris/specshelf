# export writes every document exactly once, as a JSON array (the default) or as
# JSONL, with the index record's fields.

exec specshelf --home $WORK/vault export
cmp stdout export.json

exec specshelf --home $WORK/vault export --format jsonl
cmp stdout export.jsonl

# The JSONL form is byte-identical to the index the vault itself keeps.
exec specshelf --home $WORK/vault index
cmp $WORK/vault/index.jsonl export.jsonl

# An unusable format is a usage error.
! exec specshelf --home $WORK/vault export --format tsv
stderr 'must be json or jsonl'

-- export.json --
