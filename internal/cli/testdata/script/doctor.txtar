# doctor validates the vault: a healthy one prints nothing and exits 0, a vault
# with a problem gets one stderr line per finding and a non-zero exit. stdout
# stays empty because the report is diagnostics, not a payload.

# A vault created and maintained by the tool is healthy.
exec specshelf --home $WORK/healthy init
exec specshelf --home $WORK/healthy new 'Healthy note'
exitcode 0 specshelf --home $WORK/healthy doctor
! stdout .
! stderr .

# A complete layout, so only the injected problem is reported: an unreadable
# document. The exit code is non-zero and the finding names the file.
exec specshelf --home $WORK/broken init
exitcode 1 specshelf --home $WORK/broken doctor
stderr '^specshelf: specs/2026-10-17-broken.md: unterminated frontmatter$'
! stdout .

# A document whose declared kind disagrees with its directory is reported too.
exec specshelf --home $WORK/mismatch init
exitcode 1 specshelf --home $WORK/mismatch doctor
stderr '^specshelf: specs/2026-10-17-wrong.md: kind "decision" does not match the specs directory$'
! stdout .

# A vault that is missing the layout items init creates reports each one.
exitcode 1 specshelf --home $WORK/empty doctor
stderr '^specshelf: specs: missing from the vault layout$'
stderr '^specshelf: decisions: missing from the vault layout$'
stderr '^specshelf: templates: missing from the vault layout$'
stderr '^specshelf: templates/spec\.md: missing from the vault layout$'
stderr '^specshelf: templates/decision\.md: missing from the vault layout$'
stderr '^specshelf: README\.md: missing from the vault layout$'
stderr '^specshelf: 6 problems found$'
! stdout .

# A document whose id does not match its title is reported, not only counted.
exec specshelf --home $WORK/identity init
exitcode 1 specshelf --home $WORK/identity doctor
stderr '^specshelf: specs/2026-10-17-right-title\.md: id "spec-19990101-wrong" does not match the title \(want "spec-20261017-right-title"\)$'
stderr '^specshelf: 1 problem found$'
! stdout .

# --index regenerates the index after the report; the healthy vault exits 0.
exec specshelf --home $WORK/healthy doctor --index
exists $WORK/healthy/index.jsonl

-- broken/specs/2026-10-17-broken.md --
---
id: spec-20261017-broken
kind: spec
title: Broken
-- mismatch/specs/2026-10-17-wrong.md --
---
id: spec-20261017-wrong
kind: decision
title: Wrong
status: active
created: 2026-10-17
updated: 2026-10-17
---
# Wrong
-- identity/specs/2026-10-17-right-title.md --
---
id: spec-19990101-wrong
kind: spec
title: Right Title
status: active
created: 2026-10-17
updated: 2026-10-17
---
# Right Title
